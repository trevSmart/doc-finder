{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Document Finder",
			"dependsOrder": "sequence",
			"dependsOn": ["Build Document Finder", "Start Document Finder Service"],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": true,
				"close": true
			}
		},
		{
			"label": "Build Document Finder",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new"
			}
		},
		{
			"label": "Start Document Finder Service",
			"type": "shell",
			"command": "npm",
			"args": ["run", "start:server"],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new"
			}
		},
		{
			"label": "Restart Document Finder",
			"type": "shell",
			"command": "./scripts/doc-finder.sh",
			"args": ["restart"],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new"
			}
		}
	]
}